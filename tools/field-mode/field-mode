#!/bin/bash
# field-mode: toggle battery-saving mode for field/ham radio use
# Toggle: CPU governor, WiFi power save, screen brightness

STATE_FILE="$HOME/.local/share/field-mode/state"
WIFI_IF=$(ip link | grep -E '^[0-9]+: w' | awk '{print $2}' | tr -d : | head -1)

mkdir -p "$(dirname "$STATE_FILE")"
CURRENT=$(cat "$STATE_FILE" 2>/dev/null || echo "off")

notify() {
    notify-send -i battery "Field Mode" "$1" 2>/dev/null || echo "$1"
}

get_brightness() {
    brightnessctl get 2>/dev/null || cat /sys/class/backlight/*/brightness 2>/dev/null | head -1
}

get_max_brightness() {
    brightnessctl max 2>/dev/null || cat /sys/class/backlight/*/max_brightness 2>/dev/null | head -1
}

enable_field_mode() {
    local wifi_opt="${1:-powersave}"

    # Save current brightness
    local bri
    bri=$(get_brightness)
    echo "$bri" > "$(dirname "$STATE_FILE")/saved_brightness"

    # CPU: powersave
    echo powersave | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor > /dev/null

    # WiFi
    if [ "$wifi_opt" = "wifi-off" ]; then
        [ -n "$WIFI_IF" ] && sudo ip link set "$WIFI_IF" down 2>/dev/null
        echo "wifi-off" > "$(dirname "$STATE_FILE")/saved_wifi"
    else
        [ -n "$WIFI_IF" ] && sudo iw dev "$WIFI_IF" set power_save on 2>/dev/null
        echo "powersave" > "$(dirname "$STATE_FILE")/saved_wifi"
    fi

    # Dim screen to 40%
    local max
    max=$(get_max_brightness)
    if [ -n "$max" ] && [ "$max" -gt 0 ]; then
        local target=$(( max * 40 / 100 ))
        brightnessctl set "$target" 2>/dev/null
    fi

    # TLP: force battery mode
    sudo tlp bat 2>/dev/null

    echo "on" > "$STATE_FILE"
    if [ "$wifi_opt" = "wifi-off" ]; then
        notify "ON — CPU: powersave, WiFi: OFF, brightness: 40%"
    else
        notify "ON — CPU: powersave, WiFi: power save, brightness: 40%"
    fi
}

disable_field_mode() {
    # CPU: back to schedutil
    echo schedutil | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor > /dev/null

    # WiFi restore
    local saved_wifi
    saved_wifi=$(cat "$(dirname "$STATE_FILE")/saved_wifi" 2>/dev/null || echo "powersave")
    if [ "$saved_wifi" = "wifi-off" ]; then
        [ -n "$WIFI_IF" ] && sudo ip link set "$WIFI_IF" up 2>/dev/null
    fi
    [ -n "$WIFI_IF" ] && sudo iw dev "$WIFI_IF" set power_save off 2>/dev/null

    # Restore brightness
    local saved
    saved=$(cat "$(dirname "$STATE_FILE")/saved_brightness" 2>/dev/null)
    [ -n "$saved" ] && brightnessctl set "$saved" 2>/dev/null

    # TLP: back to AC mode detection
    sudo tlp auto 2>/dev/null

    echo "off" > "$STATE_FILE"
    notify "OFF — back to normal"
}

show_help() {
    cat <<EOF
field-mode — battery-saving toggle for field/ham radio use

Usage:
  field-mode               show this help
  field-mode on            enable field mode (WiFi power save)
  field-mode on wifi-off   enable field mode (WiFi completely off)
  field-mode off           disable field mode, restore everything
  field-mode toggle        toggle on/off (uses last WiFi setting)
  field-mode status        show current state
  field-mode help          show this help

What it does:
  CPU governor   schedutil → powersave
  WiFi           power save on  (or interface down with wifi-off)
  Brightness     dims to 40% of max, restores on off
  TLP            forces battery profile, reverts to auto on off
EOF
}

case "${1:-help}" in
    on)  enable_field_mode "${2:-}" ;;
    off) disable_field_mode ;;
    status)
        saved_wifi=$(cat "$(dirname "$STATE_FILE")/saved_wifi" 2>/dev/null || echo "powersave")
        echo "Field mode: $CURRENT (wifi: ${WIFI_IF:-unknown}, wifi-mode: $saved_wifi)"
        ;;
    toggle)
        if [ "$CURRENT" = "on" ]; then
            disable_field_mode
        else
            enable_field_mode
        fi
        ;;
    help|--help|-h) show_help ;;
    *)
        echo "Unknown option: $1"
        echo
        show_help
        exit 1
        ;;
esac
