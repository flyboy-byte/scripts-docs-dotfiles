UPSTREAM=storytold/cadcraft
MIN_FREE_GB=20
SYNC=rebase
PRE_CI='if command -v actionlint >/dev/null 2>&1; then actionlint; else echo "WARNING: actionlint not installed; workflow edits are unlinted. Read the fork Packaging lint run after pushing."; fi'
CI_CMD='CARGO_PROFILE_DEV_DEBUG=0 cargo xtask ci'
