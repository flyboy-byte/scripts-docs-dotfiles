UPSTREAM=tangency-labs/solidcore
MIN_FREE_GB=15
SYNC=merge
PRE_CI='for f in crates/difftest/src/units/curve_curve_p9.rs; do rustfmt --edition 2021 --check "$f"; done'
CI_CMD='unset RUSTC_WRAPPER; export CARGO_BUILD_JOBS=3; cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings -A clippy::assert_is_empty -A clippy::explicit_iter_loop && cargo clippy --workspace --all-targets --features difftest/cpp -- -D warnings -A clippy::assert_is_empty -A clippy::explicit_iter_loop && cargo test --workspace'
RESTORE=reports/
