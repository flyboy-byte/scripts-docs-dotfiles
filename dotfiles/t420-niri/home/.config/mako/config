# Catppuccin Mocha — matches waybar / fuzzel / swaylock
font=JetBrainsMono Nerd Font 10
background-color=#1e1e2eee
text-color=#cdd6f4
border-color=#b4befe
progress-color=over #313244
border-size=2
border-radius=12
padding=12
margin=10
width=340
height=140
anchor=top-right
layer=overlay
default-timeout=6000
max-visible=4
icons=1
max-icon-size=40
format=<b>%s</b>\n%b

[urgency=low]
border-color=#6c7086
default-timeout=3000

[urgency=critical]
border-color=#f38ba8
text-color=#f38ba8
default-timeout=0

[app-name=Brave]
border-color=#fab387
