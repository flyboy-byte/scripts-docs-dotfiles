#!/bin/sh
# root helper for battmenu; called via sudoers NOPASSWD, strict args only
B=/sys/class/power_supply/BAT0
case "$1 $2" in
    "limit 80")  echo 80 > $B/charge_control_end_threshold && echo 75 > $B/charge_control_start_threshold ;;
    "limit 100") echo 0 > $B/charge_control_start_threshold && echo 100 > $B/charge_control_end_threshold ;;
    "profile auto")  tlp start ;;
    "profile saver") tlp bat ;;
    "profile perf")  tlp ac ;;
    *) echo "usage: battctl limit 80|100 | profile auto|saver|perf" >&2; exit 2 ;;
esac
